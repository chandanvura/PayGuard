    {
      "type": "timeseries",
      "title": "Payment API p95 / p99 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"payment-service\",uri=\"/api/v1/payments\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"payment-service\",uri=\"/api/v1/payments\"}[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        },
        {
          "expr": "vector(0.25)",
          "legendFormat": "250ms objective",
          "refId": "C"
        }
